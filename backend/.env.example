# TreinaSys — backend
# Copie para .env e preencha. O .env NUNCA vai pro repositório.

NODE_ENV=development
PORT=3333

# PostgreSQL
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/treinasys?schema=public"

# JWT
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# URL pública (usada no QR do certificado e nos links de e-mail)
APP_URL="http://localhost:5173"
API_URL="http://localhost:3333"
